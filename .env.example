KIT_API_KEY=your_kit_api_key
KIT_FORM_ID=your_kit_form_id

# Daily AI news generation through Groq.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Optional Kit source tags for newsletter attribution.
# Create tags in Kit first, then add the numeric/string tag IDs in Vercel and local .env.local.
KIT_TAG_SOURCE_DIRECT=
KIT_TAG_SOURCE_LINKEDIN=
KIT_TAG_SOURCE_REDDIT=
KIT_TAG_SOURCE_FAZIER=
KIT_TAG_SOURCE_UNEED=
KIT_TAG_SOURCE_PARTNER=
KIT_TAG_SOURCE_OTHER=

RESEND_API_KEY=your_resend_api_key
SUBMISSION_TO_EMAIL=info@aibeat.dev
# Optional: send submission notifications to multiple inboxes with comma-separated addresses.
# Example: SUBMISSION_TO_EMAIL=info@aibeat.dev,you@example.com
SUBMISSION_FROM_EMAIL=AIBeat Submissions <submissions@aibeat.dev>
UNSUBSCRIBE_TO_EMAIL=info@aibeat.dev
UNSUBSCRIBE_FROM_EMAIL=AIBeat Unsubscribe <submissions@aibeat.dev>
# Product Hunt outreach manager. Sending is disabled by default.
KIT_OUTREACH_TAG_ID=
KIT_DEFAULT_EMAIL_TEMPLATE_ID=
OUTREACH_ADMIN_EMAILS=
OUTREACH_SEND_ENABLED=false
OUTREACH_SAFETY_LIMIT=25
OUTREACH_TIMEZONE=America/New_York
NEXT_PUBLIC_SITE_URL=https://www.aibeat.dev
NEWSLETTER_ARTICLE_LIMIT=3
KIT_FROM_EMAIL=hello@aibeat.dev
KIT_REPLY_TO_EMAIL=hello@aibeat.dev
KIT_FROM_NAME=Nomoz Fayzullaev | AIBeat

# Optional scheduled Gmail newsletter draft creation. Disabled by default and never sends.
GMAIL_CREATE_DRAFT_ENABLED=false
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_DRAFT_TO=
GMAIL_FROM_NAME=AIBeat
GMAIL_FROM_EMAIL=

# Friday 21:00 Asia/Tashkent: draft the weekly tools email. Optional slugs must contain exactly 8 items.
GMAIL_WEEKLY_TOOLS_DRAFT_ENABLED=false
WEEKLY_TOOL_SLUGS=

# Monday 21:00 Asia/Tashkent: create individual, unsent outreach drafts from the reviewed CSV.
GMAIL_OUTREACH_DRAFTS_ENABLED=false
GMAIL_OUTREACH_INPUT_PATH=data/outreach/daily-manual-leads.csv
GMAIL_OUTREACH_DRAFT_LIMIT=10

# AIBeat Business persistence and auth.
# Use Supabase project values locally and in Vercel. Use the publishable key with Supabase Auth/RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional organization selector cookie. User identity must come from Supabase Auth, not a custom cookie.
AIBEAT_BUSINESS_ORG_COOKIE=aibeat_business_organization_id

# AIBeat Business model execution.
# Safe default: mock performs no external AI API calls.
AIBEAT_BUSINESS_AI_MODE=mock
AIBEAT_BUSINESS_AI_PROVIDER=gemini
AIBEAT_BUSINESS_MODEL=gemini-2.5-flash

# Server-side only. Never prefix with NEXT_PUBLIC_.
GEMINI_API_KEY=

# Daily AI tool lead discovery. The automation stores validated leads locally and creates Kit draft broadcasts only.
AUTOMATED_KIT_SEND_ENABLED=false
DAILY_LEAD_DISCOVERY_SOURCES=product_hunt,betalist
DAILY_LEAD_DISCOVERY_FEED_URL=https://www.producthunt.com/feed
DAILY_LEAD_DISCOVERY_BETALIST_URL=https://betalist.com
DAILY_LEAD_DISCOVERY_LOOKBACK_HOURS=48
DAILY_LEAD_DISCOVERY_MAX_CANDIDATES=30
DAILY_LEAD_DISCOVERY_MAX_LEADS=5
DAILY_LEAD_DISCOVERY_MIN_SCORE=70
DAILY_LEAD_DISCOVERY_CREATE_DRAFTS=true
DAILY_LEAD_DISCOVERY_DRY_RUN=false
DAILY_LEAD_DISCOVERY_REPORT_DIR=data/outreach/reports

# Reddit community automation for r/AIBeat.
# Keep secrets out of the repo. Add real values in GitHub Actions secrets or local .env.local.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_REFRESH_TOKEN=
REDDIT_USER_AGENT=AIBeatCommunityBot/1.0 by u/Mother_Form7041
REDDIT_SUBREDDIT=AIBeat

# Publishing is disabled by default. Dry runs always save drafts and never post to Reddit.
REDDIT_PUBLISH_ENABLED=false
REDDIT_DRY_RUN=true

# Used to build AIBeat source links in Reddit roundups.
AIBEAT_SITE_URL=https://aibeat.dev

# LinkedIn daily draft automation.
# Defaults are safe: generate GitHub artifact drafts only, no publishing.
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REFRESH_TOKEN=
LINKEDIN_AUTHOR_URN=
LINKEDIN_VERSION=202604
LINKEDIN_DAILY_DRAFT_COUNT=3
LINKEDIN_ARTICLE_LOOKBACK_DAYS=1
LINKEDIN_TONE=humanized
LINKEDIN_DRY_RUN=true
LINKEDIN_CREATE_DRAFTS_ENABLED=false
LINKEDIN_PUBLISH_ENABLED=false

# Stripe Checkout.
# Use sandbox values locally. Keep secret values out of source control.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder
# Legacy publishable key name. Prefer NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY for browser code.
STRIPE_PUBLISHABLE_KEY=pk_test_placeholder
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_test_placeholder
# Stripe webhook endpoint ID. This starts with we_ and is not used for signature verification.
STRIPE_WEBHOOK_ID=we_placeholder
# One-time paid listing price IDs. Use Stripe Price IDs that start with price_.
STRIPE_PRICE_SIMPLE_PLACEMENT=price_simple_placeholder
STRIPE_PRICE_FEATURED_PLACEMENT=price_featured_placeholder
STRIPE_PRICE_SPOTLIGHT_PRO=price_spotlight_pro_placeholder
# Legacy Stripe Product/Price variables. Keep only if an older deployment path still references them.
STRIPE_PRICE_ID=price_legacy_placeholder
STRIPE_PRODUCT_ID=prod_legacy_placeholder
