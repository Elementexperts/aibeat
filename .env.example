KIT_API_KEY=your_kit_api_key
KIT_FORM_ID=your_kit_form_id

# Optional Kit source tags for newsletter attribution.
# Create tags in Kit first, then add the numeric/string tag IDs in Vercel and local .env.local.
KIT_TAG_SOURCE_DIRECT=
KIT_TAG_SOURCE_LINKEDIN=
KIT_TAG_SOURCE_REDDIT=
KIT_TAG_SOURCE_FAZIER=
KIT_TAG_SOURCE_UNEED=
KIT_TAG_SOURCE_PARTNER=
KIT_TAG_SOURCE_OTHER=

RESEND_API_KEY=your_resend_api_key
SUBMISSION_TO_EMAIL=info@aibeat.dev
SUBMISSION_FROM_EMAIL=AIBeat Submissions <submissions@aibeat.dev>
# Product Hunt outreach manager. Sending is disabled by default.
KIT_OUTREACH_TAG_ID=
KIT_DEFAULT_EMAIL_TEMPLATE_ID=
OUTREACH_ADMIN_EMAILS=
OUTREACH_SEND_ENABLED=false
OUTREACH_SAFETY_LIMIT=25
OUTREACH_TIMEZONE=America/New_York
NEXT_PUBLIC_SITE_URL=https://www.aibeat.dev
KIT_FROM_EMAIL=hello@aibeat.dev
KIT_REPLY_TO_EMAIL=hello@aibeat.dev
KIT_FROM_NAME=Nomoz Fayzullaev | AIBeat

# Daily AI tool lead discovery. The automation stores validated leads locally and creates Kit draft broadcasts only.
AUTOMATED_KIT_SEND_ENABLED=false
DAILY_LEAD_DISCOVERY_SOURCES=product_hunt,betalist
DAILY_LEAD_DISCOVERY_FEED_URL=https://www.producthunt.com/feed
DAILY_LEAD_DISCOVERY_BETALIST_URL=https://betalist.com
DAILY_LEAD_DISCOVERY_LOOKBACK_HOURS=48
DAILY_LEAD_DISCOVERY_MAX_CANDIDATES=30
DAILY_LEAD_DISCOVERY_MAX_LEADS=5
DAILY_LEAD_DISCOVERY_MIN_SCORE=70
DAILY_LEAD_DISCOVERY_CREATE_DRAFTS=true
DAILY_LEAD_DISCOVERY_DRY_RUN=false
DAILY_LEAD_DISCOVERY_REPORT_DIR=data/outreach/reports

# Reddit community automation for r/AIBeat.
# Keep secrets out of the repo. Add real values in GitHub Actions secrets or local .env.local.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_REFRESH_TOKEN=
REDDIT_USER_AGENT=AIBeatCommunityBot/1.0 by u/Mother_Form7041
REDDIT_SUBREDDIT=AIBeat

# Publishing is disabled by default. Dry runs always save drafts and never post to Reddit.
REDDIT_PUBLISH_ENABLED=false
REDDIT_DRY_RUN=true

# Used to build AIBeat source links in Reddit roundups.
AIBEAT_SITE_URL=https://aibeat.dev

# LinkedIn daily draft automation.
# Defaults are safe: generate GitHub artifact drafts only, no publishing.
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=
LINKEDIN_VERSION=202604
LINKEDIN_DAILY_DRAFT_COUNT=3
LINKEDIN_ARTICLE_LOOKBACK_DAYS=1
LINKEDIN_TONE=humanized
LINKEDIN_DRY_RUN=true
LINKEDIN_CREATE_DRAFTS_ENABLED=false
LINKEDIN_PUBLISH_ENABLED=false
